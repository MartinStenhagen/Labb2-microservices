# Valfria, icke-kansliga lokala installningar for Docker Compose.
# Riktiga hemligheter ligger i secrets/*.txt eller i din lokala .env-fil.

BOT_AI_ENABLED=false
BOT_AI_BASE_URL=https://openrouter.ai/api/v1
BOT_AI_MODEL=z-ai/glm-4.5-air:free
BOT_AI_TEMPERATURE=0.3

# Om du aktiverar AI lokalt kan du satta nyckeln i din privata .env-fil:
# OPENROUTER_API_KEY=replace-with-your-key
